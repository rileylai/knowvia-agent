APP_ENV=local
LOG_LEVEL=INFO

# PostgreSQL / pgvector
POSTGRES_PORT=5433
POSTGRES_USER=knowvia
POSTGRES_PASSWORD=knowvia
POSTGRES_DB=knowvia
DATABASE_URL=postgresql+psycopg://knowvia:knowvia@localhost:5433/knowvia

# OpenAI
OPENAI_API_KEY=

# Embedding batching / retry
EMBEDDING_BATCH_MAX_INPUTS=512
EMBEDDING_BATCH_MAX_SINGLE_INPUT_BYTES=32768
EMBEDDING_BATCH_MAX_SINGLE_INPUT_TOKEN_ESTIMATE=8000
EMBEDDING_BATCH_MAX_AGGREGATE_BYTES=1000000
EMBEDDING_BATCH_MAX_AGGREGATE_TOKEN_ESTIMATE=250000
EMBEDDING_REQUEST_MAX_ATTEMPTS=3
EMBEDDING_RETRY_BASE_SECONDS=1
EMBEDDING_RETRY_MAX_SECONDS=30

# API auth
API_BEARER_TOKEN=

# Operator / cost controls
MAX_WORKFLOW_COST_USD=
MAX_DAILY_COST_USD=
